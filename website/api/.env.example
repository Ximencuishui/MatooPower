# Matoo Admin API · environment variables (sample)
# Copy this file to ".env" and customize.
# All variables have safe defaults if missing.

# HTTP listener
PORT=8000
BIND=127.0.0.1

# Admin password. If absent at first boot, a random one is generated
# and printed to the console (also stored in api/data/admin.json).
# ADMIN_PASSWORD=change-me-please

# Session signing secret. Auto-generated and persisted if missing.
# SESSION_SECRET=

# Upload limits
MAX_UPLOAD_MB=10

# Enable sharp-based multi-size generation. If false or sharp not
# installed, uploads save the original only and you must run
# scripts/generate-srcset.ps1 manually.
SHARP_ENABLED=true