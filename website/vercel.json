{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:lang(zh|ja|ko|bn|hi|ur|ta|te|ar|fr|pt|es|en)",
      "destination": "/:lang.html"
    },
    {
      "source": "/:page(about|products|technology|manufacturing|partnership|insights|contact|configurator)",
      "destination": "/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
