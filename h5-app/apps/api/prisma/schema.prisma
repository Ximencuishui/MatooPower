// Matoo Power API · Prisma schema (SQLite, demo period)
// Tables: User / OtpRequest / Session / Sku / QrSignature / Warranty / Device

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  phone            String?   @unique
  email            String?   @unique
  passwordHash     String?
  role             String    @default("customer") // 'customer' | 'dealer' | 'admin' | 'support' | 'anonymous'
  displayName      String?
  dealerId         String?   // v1.4 P1-2:经销商独立 Dealer 表外键,旧 dealer user 暂留 null
  dealer           Dealer?   @relation("DealerMembers", fields: [dealerId], references: [id])
  deletedAt        DateTime? // v1.4 P1-1:GDPR 软删时间戳
  anonymizedPhone  String?   // v1.4 P1-1:删除前 phone 哈希备份(SHA256),用于审计
  anonymizedEmail  String?   // v1.4 P1-1:删除前 email 哈希备份
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  warranties       Warranty[]
  devices          Device[]
  activatedSkus    Sku[]     @relation("ActivatedBy")
  tickets          Ticket[]  @relation("TicketAuthor")
  assignedTickets  Ticket[]  @relation("TicketAssignee")
  ticketMessages   TicketMessage[] @relation("TicketSender")
  createdDealers   Dealer[]  @relation("DealerCreator")
  uploadedSkuImages SkuImage[] @relation("SkuImageUploader")

  @@index([role])
  @@index([dealerId])
  @@index([deletedAt])
}

model OtpRequest {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([phone, consumedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Sku {
  id                    String   @id @default(cuid())
  sku                   String
  serial                String   @unique
  batch                 String
  batchId               String?
  batchRel              SkuBatch? @relation(fields: [batchId], references: [id])
  mfgDate               DateTime
  modelName             String
  family                String   // 'battery' | 'controller' | 'panel'
  capacity              String
  voltage               String
  chemistry             String
  cycles                String
  warrantyMonthsWhole   Int
  warrantyMonthsCell    Int?
  warrantyMonthsBms     Int?
  warrantyMonthsParts   Int?
  // v1.4 P2-3:商品库扩展字段(后台可编辑)
  description           String?   // 商品资料/富文本描述(≤5000字)
  imageUrls             String?   // JSON 字符串数组(主图集快照;权威数据在 SkuImage 表)
  videoTrailerUrl       String?   // 主视频预告 URL(与 SkuDocument video 互补)
  guidePriceCents       Int?      // 全局指导价(最小单位:分)
  guidePriceCurrency    String?   // ISO 4217 三字母,默认 BDT
  guidePriceNote        String?   // 价格备注(例 "限时活动 -5%" / "含税")
  catalogUpdatedAt      DateTime? // 最后一次后台编辑时间(便于审计 + cache 失效)
  catalogUpdatedBy      String?   // 最后编辑人 userId(便于审计)
  activated             Boolean  @default(false)
  activatedAt           DateTime?
  activatedByUserId     String?
  activatedByUser       User?    @relation("ActivatedBy", fields: [activatedByUserId], references: [id])
  createdAt             DateTime @default(now())

  qrSignatures QrSignature[]
  warranties   Warranty[]
  devices      Device[]
  documents    SkuDocument[]
  images       SkuImage[]

  @@index([sku])
  @@index([batch])
  @@index([batchId])
  @@index([catalogUpdatedAt])
}

// v1.4 P2-3:SKU 详情图片集(多语言 + 排序 + 软删除)
model SkuImage {
  id                String    @id @default(cuid())
  skuId             String
  sku               Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  lang              String    @default("en")    // 'zh' | 'en' | 'bn' | 'hi' | 'ur'
  storageKey        String
  url               String
  mimeType          String
  sizeBytes         Int
  width             Int?
  height            Int?
  alt               String?
  caption           String?
  sortOrder         Int       @default(0)
  isCover           Boolean   @default(false)
  sha256            String
  uploadedByUserId  String?
  uploadedBy        User?    @relation("SkuImageUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedAt        DateTime  @default(now())
  deprecatedAt      DateTime?

  @@index([skuId, lang])
  @@index([skuId, sortOrder])
  @@index([sha256])
  @@index([deprecatedAt])
  @@index([skuId, isCover])
}

model QrSignature {
  id         String    @id @default(cuid())
  qrId       String    @unique
  skuId      String
  sku        Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  signature  String
  revoked    Boolean   @default(false)
  scanCount  Int       @default(0)
  lastScanAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([skuId])
}

model Warranty {
  id               String   @id @default(cuid())
  skuId            String
  sku              Sku      @relation(fields: [skuId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  country          String
  city             String
  dealerName       String?
  invoiceNo        String?
  invoiceDate      DateTime?
  invoiceAmount    Float?
  invoicePhotoUrl  String?
  status           String   @default("active") // 'active' | 'pending' | 'expired' | 'rejected'
  startAt          DateTime
  endAtWhole       DateTime
  endAtCell        DateTime?
  endAtBms         DateTime?
  endAtParts       DateTime?
  reviewNotes      String?
  createdAt        DateTime @default(now())

  @@index([skuId])
  @@index([userId])
  @@index([status])
}

model Device {
  id         String   @id @default(cuid())
  skuId      String
  sku        Sku      @relation(fields: [skuId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  boundAt    DateTime @default(now())
  lastSeenAt DateTime @default(now())
  soh        Int?
  soc        Int?
  cycles     Int?
  temp       Float?
  volt       Float?
  curr       Float?
  fw         String?
  alarms     Int?
  createdAt  DateTime @default(now())

  @@index([skuId])
  @@index([userId])
}

model Ticket {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("TicketAuthor", fields: [userId], references: [id])
  skuId           String?
  sku             Sku?     @relation(fields: [skuId], references: [id])
  deviceId        String?
  device          Device?  @relation(fields: [deviceId], references: [id])
  type            String   @default("general")  // 'general' | 'warranty' | 'inquiry' | 'remote'
  severity        String   @default("normal")  // 'low' | 'normal' | 'high' | 'urgent'
  subject         String
  description     String
  contactPhone    String?
  status          String   @default("open")     // 'open' | 'in_progress' | 'waiting_customer' | 'resolved' | 'closed'
  assigneeUserId  String?
  assignee        User?     @relation("TicketAssignee", fields: [assigneeUserId], references: [id])
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        TicketMessage[]

  @@index([userId])
  @@index([skuId])
  @@index([status])
  @@index([assigneeUserId])
}

model TicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String?
  sender       User?    @relation("TicketSender", fields: [senderUserId], references: [id])
  senderRole   String                                // 'customer' | 'support' | 'system'
  body         String
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketStatusLog {
  id          String   @id @default(cuid())
  ticketId    String
  actorUserId String
  fromStatus  String
  toStatus    String
  resolution  String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([actorUserId])
  @@index([createdAt])
}

model WarrantyReviewLog {
  id          String   @id @default(cuid())
  warrantyId  String
  actorUserId String
  fromStatus  String
  toStatus    String
  notes       String?
  createdAt   DateTime @default(now())

  @@index([warrantyId])
  @@index([actorUserId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String?
  action      String
  resource    String?
  payload     String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

// v1.4 P1-2:经销商独立 Dealer 表(解耦 User.role='dealer')
model Dealer {
  id              String   @id @default(cuid())
  companyName     String
  country         String   // ISO 3166-1 alpha-2
  tier            String   @default("silver")   // 'silver' | 'gold' | 'platinum'
  contactEmail    String?
  contactPhone    String?
  status          String   @default("active")  // 'active' | 'suspended'
  note            String?
  createdByUserId  String?
  createdBy       User?    @relation("DealerCreator", fields: [createdByUserId], references: [id])
  members         User[]   @relation("DealerMembers")
  priceLists      DealerPriceList[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([country])
}

// v1.4 P1-2:Dealer 专属价(某 dealer 对某 SKU 的特别价格)
model DealerPriceList {
  id              String    @id @default(cuid())
  dealerId        String
  dealer          Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  skuId           String
  sku             Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  priceCents      Int
  currency        String    @default("BDT")
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([dealerId])
  @@index([skuId])
  @@index([effectiveFrom, effectiveTo])
}

// v1.3 P0:SKU 批次表（生产批次维度）
model SkuBatch {
  id                  String   @id @default(cuid())
  batchCode           String   @unique                       // 例 'BATCH-2026Q3-001'
  mfgDate             DateTime
  factory             String?                                // 例 'Matoo Plant A'
  destinationCountry  String?                                // ISO 3166-1 alpha-2
  totalQuantity       Int      @default(0)                   // 计划生产数
  note                String?
  createdByUserId     String?
  createdAt           DateTime @default(now())

  skus       Sku[]
  documents  SkuDocument[]
  qrBatches  QrBatch[]

  @@index([mfgDate])
}

// v1.3 P0:SKU 文档表（多语言 + 多版本）
model SkuDocument {
  id                String    @id @default(cuid())
  skuId             String
  sku               Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             SkuBatch? @relation(fields: [batchId], references: [id])
  type              String                                 // 'manual' | 'video' | 'specsheet' | 'faq'
  lang              String                                 // 'zh' | 'en' | 'bn' | 'hi' | 'ur'
  version           String                                 // 手动版本号 'v1.0' / 'v1.1'
  title             String
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String                                 // 本地相对路径或对象存储 key
  sha256            String                                 // 内容哈希，防篡改 + 重复上传检测
  uploadedByUserId  String?
  uploadedAt        DateTime  @default(now())
  deprecatedAt      DateTime?                              // 软删除：保留历史，7 天后清理磁盘

  @@unique([skuId, type, lang, version])
  @@index([skuId, type, lang])
  @@index([batchId])
  @@index([sha256])
  @@index([deprecatedAt])
}

// v1.3 P0:QR 批量生成任务
model QrBatch {
  id                 String                @id @default(cuid())
  batchId            String
  batch              SkuBatch             @relation(fields: [batchId], references: [id])
  totalQuantity      Int
  generatedCount     Int                   @default(0)
  status             String                @default('pending')  // 'pending' | 'running' | 'done' | 'failed'
  zipStorageKey      String?
  errorMessage       String?
  generatedByUserId  String
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime              @default(now())

  @@index([batchId])
  @@index([status])
  @@index([createdAt])
}