# =============================================================================
# Matoo Power API · Production environment template (.env.example)
# 部署时复制为 .env 并填入真实值。.env 不入 git;.env.example 入 git。
# =============================================================================

# --- 基础 ---
PORT=3001
NODE_ENV=production  # production / development / test
WEB_ORIGIN="https://admin.matoopower.com"
DATABASE_URL="file:./prisma/dev.db"  # 演示期 SQLite;生产期改为 Postgres URL

# --- 安全(生产期必须替换 demo 值) ---
# 生成: openssl rand -base64 48
JWT_SECRET="CHANGE-ME-IN-PRODUCTION-7f3c1a"
JWT_EXPIRES_IN="7d"
QR_HMAC_SECRET="CHANGE-ME-IN-PRODUCTION"

# --- OTP(参见 src/common/otp-delivery.ts) ---
OTP_TTL_SECONDS=300          # 验证码有效期(秒)
OTP_MAX_FAILS=5              # 窗口内最大失败次数
OTP_LOCK_MINUTES=15          # 锁定窗口(分钟)

# v1.4 T-2d X4:OTP 投递渠道
# - console:演示模式(写 pino warn 日志,含验证码)
# - http-webhook:生产模式,调用任意 SMS provider webhook
OTP_DELIVERY=http-webhook

# 生产期 SMS provider 配置(http-webhook 模式必填)
# 任何支持 HTTP POST 的 SMS 网关都可对接(自建 / Twilio Functions / 阿里云函数 / etc.)
# 期望网关收到 { phone, code, ttl, source } 后发短信,返回 2xx 即视为成功
OTP_WEBHOOK_URL="https://sms-gateway.internal.matoopower.com/v1/send-otp"
OTP_WEBHOOK_TOKEN=""         # 网关 HMAC/Bearer 鉴权 token(可选)
OTP_WEBHOOK_TIMEOUT_MS=5000  # 网关超时(毫秒)
OTP_WEBHOOK_SOURCE="matoo-prod"

# 演示期调试模式开关
DEV_FIXED_OTP=""             # 留空=每次随机;演示调试可填 123456(固定调试码)
# OTP_ALLOW_CONSOLE_IN_PROD=1  # 生产期禁用 console;仅紧急调试时显式打开

# --- SLA 自动升级(v1.4 P1-3) ---
# 缺省:normal 120 分钟后无人提到 → high;high 240 分钟后未解决 → urgent
# TICKET_SLA_NORMAL_TO_HIGH_MIN=120
# TICKET_SLA_HIGH_TO_URGENT_MIN=240
SLA_CRON_DISABLED=0          # 0=启用,1=关闭
SLA_CRON_INTERVAL_MS=60000

# --- 跨产品对接(v1.4 T-2d X2) ---
# 询盘从 website 转发到此处时使用的 publicUrl(仅测试需要重写)
# PUBLIC_BASE_URL=https://api.matoopower.com

# --- 监控(T6 Sentry) ---
# SENTRY_DSN=""               # 留空=禁用 Sentry(空 DSN 时 instrument.ts 内部跳过 init)
# PINO_LOG_LEVEL=info

# --- CORS 多域名(可选,逗号分隔追加) ---
# WEB_ORIGIN_EXTRA="https://app.matoopower.com,https://www.matoopower.com"