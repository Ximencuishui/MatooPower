# ============================================
# MatooPower 仓库根目录 .gitignore
# ============================================

# Node / pnpm
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/

# 环境变量与密钥
.env
.env.local
.env.*.local
**/.env
**/.env.local

# 日志与数据库
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# TypeScript 构建信息
*.tsbuildinfo
**/*.tsbuildinfo

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 运行时数据(管理后台 API 自动产生)
website/api/data/
website/api/data/**/*.json
!website/api/data/.gitkeep

# 临时验证截图(开发验收产物,不入库)
verify-*.png

# PowerShell 临时审计脚本(本地一次性工具)
_*audit*.ps1
_*audit*.js
_*fix*.ps1
_*fix*.js
_*reverify*.ps1
_*reverify*.js
# 本地 i18n 修复/翻译脚本(一次性工具,不入库)
# 注：_audit_*.out / _audit_*.md / _i18n_fix_report.md / _translation_cache.json
# 是审计产物，进入版本控制
_audit_*.tmp
_check_used_keys.js
_cleanup_cache.js
_extract_fallbacks.js
_fallback_keys.json
_inject_v3.js
_missing_keys.txt
_missing_translations.md
_nestify_dicts.js
_translate_all.js
_translation_cache.dirty.json
_verify_clean.js

# 启动/预览脚本(本地一键启动,可选)
start-*.ps1
start-*.bat

# 生成的 HTML 引用清单(本地审计副产物)
html-references.txt
verify-results.txt

# 临时缓存
.cache/
.tmp/
tmp/

# 一次性调试脚本/审计副产物(2026-09 P0/P1 验收期产物)
_diag_*.js
_diag_*.out
_check_*.js
_clean_*.js
_list_langs.*
_prune_*.txt
_backfill_out.txt
_gate_*.txt
_verify_ps1.txt
_diff_index.txt
_git_status.txt
_audit_*.txt
.audit_full.out