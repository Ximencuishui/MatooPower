# ============================================
# MatooPower 仓库根目录 .gitignore
# ============================================

# Node / pnpm
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/

# 环境变量与密钥
.env
.env.local
.env.*.local
**/.env
**/.env.local

# 日志与数据库
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.db
*.db-journal
*.sqlite
*.sqlite3

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 运行时数据(管理后台 API 自动产生)
website/api/data/
website/api/data/**/*.json
!website/api/data/.gitkeep

# 临时验证截图(开发验收产物,不入库)
verify-*.png

# PowerShell 临时审计脚本(本地一次性工具)
_*audit*.ps1
_*audit*.js
_*fix*.ps1
_*fix*.js
_*reverify*.ps1
_*reverify*.js

# 启动/预览脚本(本地一键启动,可选)
start-*.ps1
start-*.bat

# 生成的 HTML 引用清单(本地审计副产物)
html-references.txt
verify-results.txt

# 临时缓存
.cache/
.tmp/
tmp/